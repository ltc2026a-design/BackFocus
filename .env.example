# FocusFlow backend — ejemplo de entorno. Copia a .env y ajusta.
DATABASE_URL="file:./dev.db"
PORT=4000
JWT_SECRET="cambia-este-secreto-de-acceso"
JWT_REFRESH_SECRET="cambia-este-secreto-de-refresh"
JWT_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_DAYS=7
# Orígenes web (Vite/Tauri). La WebView de la app móvil (https://localhost,
# http://localhost, capacitor://localhost) se permite siempre, no va aquí.
CORS_ORIGINS="http://localhost:5173,http://localhost:1420"

# Email (SMTP real). Vaciar SMTP_HOST = modo simulado (correos por consola).
APP_URL="http://localhost:5173"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="FocusFlow <no-reply@focusflow.app>"
